{
  "manifest_version": 3,
  "name": "Prompt Manager",
  "version": "0.1.0",
  "description": "Bibliothèque locale de prompts pour les sites d'IA (Claude, ChatGPT, Gemini, DeepSeek, Mistral…) : enregistrer, rechercher, recharger.",
  "author": "Alexandre Calligaro",
  "minimum_chrome_version": "111",
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "permissions": ["activeTab", "scripting", "storage", "unlimitedStorage"],
  "action": { "default_popup": "popup.html", "default_title": "Prompt Manager", "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png" } },
  "options_ui": { "page": "popup.html", "open_in_tab": true }
}
